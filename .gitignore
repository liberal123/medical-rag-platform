# Publish only the maintained project; keep original local scripts private.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/pyproject.toml
!/requirements*.txt
!/src/
!/web/
!/examples/
!/scripts/
!/tests/
!/docs/
!/.github/
!/reports/
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*
!.env.example
.idea/
.vscode/
*.safetensors
*.pt
*.pth
*.bin
*.db
*.sqlite
*.pdf
*.zip
docs/local_review.md
